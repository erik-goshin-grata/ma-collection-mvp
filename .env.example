# M&A Collection MVP — Environment Variables
#
# Copy this file to .env and fill in your actual values.
# .env is git-ignored; never commit real API keys.

# --- Required: LLM provider ---

# Options: anthropic | openai
# Default in config.py is anthropic for backward compatibility.
LLM_PROVIDER=anthropic

# --- Required: API credentials ---

# Anthropic API key for Claude Opus and Haiku calls.
# Required when LLM_PROVIDER=anthropic.
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# OpenAI API key for Responses API calls.
# Required when LLM_PROVIDER=openai.
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# sec-api.io API key for SEC filing queries and extraction
# Personal & Startups tier or better is sufficient for MVP scale
# Get one at: https://sec-api.io
SEC_API_KEY=REPLACE-ME

# --- Required: operator contact ---

# Used in the User-Agent header when scraping PR Newswire.
# Identifies you as the operator to the site if they need to contact you.
OPERATOR_CONTACT_EMAIL=your.email@example.com

# --- Optional: PR Newswire adapter ---

# Cap on the number of press releases to fetch per run.
# Default: 100. Increase for larger runs after MVP validates.
MAX_FETCHES=100

# Seconds to sleep between outbound requests (rate limiting).
# Default: 1.5. Raised automatically if robots.txt specifies a Crawl-delay.
REQUEST_DELAY_SECONDS=1.5

# Full User-Agent string. The default includes the operator email above.
# Override only if you need to customize further.
# USER_AGENT_STRING=MA-Collection-MVP/0.1 (contact: your.email@example.com)

# --- Optional: sec-api.io adapter ---

# Seconds to sleep between sec-api.io requests.
# Default: 0.2 (≈ 5 req/sec). Lower only if tier rate limits allow.
SEC_API_REQUEST_DELAY_SECONDS=0.2

# Legacy symmetric days around announced_date to search for matching SEC filings.
# Retained for compatibility; 8-K enrichment now uses the explicit lookback/lookahead below.
SEC_DATE_WINDOW_DAYS=7

# 8-K enrichment lookup window around announced_date.
# News sources may trail issuer filings, so the default looks farther backward.
SEC_LOOKBACK_DAYS=30
SEC_LOOKAHEAD_DAYS=7

# --- Optional: database & logging ---

# Path to the SQLite database file.
# Default: data/ma_mvp.db
DB_PATH=data/ma_mvp.db

# Log verbosity. Default: INFO.
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional prefix for run_id labels, useful to distinguish test runs from production.
# Leave empty unless needed.
# RUN_ID_PREFIX=test

# Stage 9 read path. Defaults to observation, which reads the observation ledger
# and is the only path that keeps multiple independently typed values from one
# source distinct. Set staging only to roll back or debug against the legacy read.
# Options: staging | observation
AGGREGATION_READ_SOURCE=observation

# --- Optional: model strings ---
# Defaults are set in config.py and reflect current production strings as of 2026-04-22.
# Override here to pin to a specific model version without changing code.
OPUS_MODEL=claude-opus-4-7
HAIKU_MODEL=claude-haiku-4-5-20251001

# --- Optional: OpenAI model strings ---
# Used only when LLM_PROVIDER=openai. Defaults are set in config.py.
# Current defaults are low-cost GPT-5 variants for routine stages and a stronger
# GPT-5.2 model for legal/reasoning-heavy stages.
OPENAI_RELEVANCY_MODEL=gpt-5-nano
OPENAI_CLASSIFICATION_MODEL=gpt-5-mini
OPENAI_EXTRACT_MODEL=gpt-5-mini
OPENAI_LEGAL_EXTRACT_MODEL=gpt-5.2
OPENAI_REASONING_MODEL=gpt-5.2
