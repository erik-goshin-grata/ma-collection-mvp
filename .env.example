# M&A Collection MVP — Environment Variables
#
# Copy this file to .env and fill in your actual values.
# .env is git-ignored; never commit real API keys.

# --- Required: API credentials ---

# Anthropic API key for Claude Opus and Haiku calls
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# sec-api.io API key for SEC filing queries and extraction
# Personal & Startups tier or better is sufficient for MVP scale
# Get one at: https://sec-api.io
SEC_API_KEY=REPLACE-ME

# --- Required: operator contact ---

# Used in the User-Agent header when scraping PR Newswire.
# Identifies you as the operator to the site if they need to contact you.
OPERATOR_CONTACT_EMAIL=your.email@example.com

# --- Optional: PR Newswire adapter ---

# Cap on the number of press releases to fetch per run.
# Default: 100. Increase for larger runs after MVP validates.
MAX_FETCHES=100

# Seconds to sleep between outbound requests (rate limiting).
# Default: 1.5. Raised automatically if robots.txt specifies a Crawl-delay.
REQUEST_DELAY_SECONDS=1.5

# Full User-Agent string. The default includes the operator email above.
# Override only if you need to customize further.
# USER_AGENT_STRING=MA-Collection-MVP/0.1 (contact: your.email@example.com)

# --- Optional: sec-api.io adapter ---

# Seconds to sleep between sec-api.io requests.
# Default: 0.2 (≈ 5 req/sec). Lower only if tier rate limits allow.
SEC_API_REQUEST_DELAY_SECONDS=0.2

# Days around announced_date to search for matching 8-K filings.
# Default: 7.
SEC_DATE_WINDOW_DAYS=7

# --- Optional: database & logging ---

# Path to the SQLite database file.
# Default: data/ma_mvp.db
DB_PATH=data/ma_mvp.db

# Log verbosity. Default: INFO.
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional prefix for run_id labels, useful to distinguish test runs from production.
# Leave empty unless needed.
# RUN_ID_PREFIX=test
